      "path": "/api/v2/search/tickets?query=<%= context.query %>&page=<%= context.page %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    },
    "options": {}
  }
}